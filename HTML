          <a href="#" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-amber-500 hover:text-white transition"><i class="fa-brands fa-instagram"></i></a>
          <a href="#" class="w-10 h-10 rounded-full bg-slate-800 flex items-center justify-center hover:bg-amber-500 hover:text-white transition"><i class="fa-brands fa-google"></i></a>
        </div>
