      <div>
        <div class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 rounded-full bg-amber-500 flex items-center justify-center text-white text-sm font-bold">
            <i class="fa-solid fa-utensils"></i>
          </div>
          <span class="font-serif-heading text-xl font-bold text-white">The Curry Spoon</span>
        </div>
        <p class="text-sm text-slate-400">Delivering unforgettable culinary experiences made with passion, tradition, and fresh ingredients.</p>
