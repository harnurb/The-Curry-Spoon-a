      <a href="tel:6208000049" class="bg-white text-slate-900 hover:bg-slate-100 font-bold px-8 py-4 rounded-full transition shadow-lg shrink-0 flex items-center gap-3">
        <i class="fa-solid fa-phone text-amber-600"></i>
        <span>Call 620-800-0049</span>
